# ============================================================
# 以虎 One 平台配置（yh init 会复制为 yh.env 并生成密钥）
# 只放平台运行必需的东西；登录方式、模型、用户、应用都在控制台里配置
# ============================================================

# ---- 访问地址：控制台 = PUBLIC_URL，应用 = PUBLIC_URL/apps/<code>/ ----
# yh init --url https://one.example.com 写入；测试模式为 http://localhost:18080
PUBLIC_URL=
# 应用独立域名（推荐生产配）：配了以后代码应用在 <APPS_URL>/apps/<code>/，和控制台不同源，应用页面里的脚本拿不到控制台的登录凭证。
# 留空 = 应用挂在 PUBLIC_URL/apps/<code>/ 下。要先把这个域名解析到入口服务器，并在云服务器上用 APPS_DOMAIN 重跑 cloud/install.sh。
# 改了执行 yh start：各应用会自动换地址、换统一登录回调，老地址自动跳转到新域名的同一路径；应用不用改
APPS_URL=

# ---- 这是哪家公司的平台（install.sh --company 写入；只用来标识，交付单、通知里会带上）----
COMPANY=

# ---- 国内网络 / 内网（install.sh --cn 会填好；留空走官方源）----
# Docker Hub 镜像前缀（平台的 Caddy / MySQL / Redis / frpc 和控制台构建用的 node 镜像），如 docker.m.daocloud.io/（末尾要带 /）
# 应用自己的 Dockerfile 不受它管：应用也拉不动时，给 Docker 配 registry-mirrors（见部署手册「国内网络」）
IMAGE_MIRROR=
# 控制台构建时的 npm 源，如 https://registry.npmmirror.com
NPM_REGISTRY=
# Prisma 引擎下载镜像，如 https://registry.npmmirror.com/-/binary/prisma
PRISMA_ENGINES_MIRROR=
# 构建控制台时不装可选依赖（OpenHex 模型接入 SDK，协议未定）：=1 时 OpenHex 模型不可用，其他不受影响
CONSOLE_OMIT_OPTIONAL=
# 控制台镜像：auto（默认：更新包方式安装时下载发布好的镜像，Git 检出里现场构建；用了 OpenHex 模型时也现场构建）/ pull / build
CONSOLE_IMAGE=
# 预构建控制台镜像的仓库（不带版本号）；国内网络用 ghcr.m.daocloud.io/guoylyy/yihu-one-console（--cn 会填好）
CONSOLE_IMAGE_REPO=

# ---- 运行模式：production 生产 / test 测试（yh init --test 自动设置：开发登录、不连隧道、不发通知）----
PLATFORM_MODE=production

# ---- 本机入口（生产只监听本机，外部流量经隧道或前置反代进来；局域网测试时为 0.0.0.0）----
LOCAL_HTTP_PORT=18080
LOCAL_HTTP_BIND=127.0.0.1

# ---- 隧道（可选）：机器在内网、没有公网 IP 时，经云服务器上的 frps 对外。留空 = 不用隧道 ----
FRP_SERVER_ADDR=
FRP_SERVER_PORT=7000
FRP_TOKEN=
# 额外隧道（可选）：内网里不归平台管的独立服务，经同一条隧道直通一个自己的域名（平台只转发，不管登录、不管进程）。
# 和托管应用（跑在平台容器里、挂在 /apps/<code>/ 下）是两回事。格式：<对外域名>=<地址>:<端口>，多条用英文逗号分隔；
# 地址是 frpc 容器里访问得到的地址，宿主机上的服务写 host.docker.internal。不要带空格（要带就给整个值加引号）。
# 改完执行 yh start 生效；云服务器还要放行这个域名，全流程见 docs/发布方式.md「把内网独立服务挂到子域名」
# 例：EXTRA_TUNNELS=notes.example.com=host.docker.internal:3005,wiki.example.com=192.168.1.20:8080
EXTRA_TUNNELS=

# ---- 控制台镜像模式（小内存服务器）：CONSOLE_DEPLOY=image 时本机不构建控制台，
# 镜像由 scripts/push-console-image.sh 推到仓库、scripts/sync-console-image.sh（cron 每 5 分钟）自动同步上线
# CONSOLE_DEPLOY=
ACR_REGISTRY=registry.cn-shanghai.aliyuncs.com
ACR_NAMESPACE=

# ---- 自动生成，勿外传 ----
MYSQL_ROOT_PASSWORD=
CONSOLE_DB_PASSWORD=
CONSOLE_JWT_SECRET=
# 加密控制台里保存的模型 API Key、钉钉密钥等；换了之后已保存的密钥要重填
CONSOLE_SECRET_KEY=
# 平台接口令牌：yh 用它登记应用、领取控制台下发的操作
PLATFORM_TOKEN=
# 无头安装的兜底：首次启动时自动建管理员 admin 用的密码（已有用户后不再起作用；忘了密码用 yh passwd admin）
# 留空 = 生产安装走浏览器初始化向导（打开访问地址设置管理员和站点信息）；测试模式 yh init --test 会自动生成
ADMIN_INITIAL_PASSWORD=

# ---- 备份 ----
BACKUP_KEEP_DAYS=14
# 异地备份目标（rsync over ssh），如 root@1.2.3.4:/root/yh-backups；留空只在本机保留
BACKUP_REMOTE=

# ---- 自动发布（yh agent）----
# 发布通知：机器人在控制台「系统设置 → 发布通知」里配（支持飞书 / 钉钉 / 企业微信，可发测试消息）。
# 下面两个钉钉变量只是老安装的兜底，配了控制台设置后不再生效
# 选「自定义关键词」时，关键词设为「发布」（所有通知都带这两个字）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 平台自身跟踪的分支（agent 每轮先自更新，控制台代码有变化会自动重新构建）
PLATFORM_BRANCH=release
# 检查各应用发布分支的间隔（秒）
WATCH_INTERVAL=120

# ---- 平台升级（yh upgrade，用更新包安装的机器）----
# 更新清单 latest.json 的地址（发布方提供）。配了以后 agent 每 6 小时查一次新版本，控制台「管理 → 概览」里可以一键升级
# 留空 = 不联网查：把更新包拷进来执行 yh upgrade --package <包>，或在控制台上传更新包
UPGRADE_URL=
