# ============================================================
# 以虎 One 控制台后端 —— 本地开发用的环境变量
# 平台上运行时由 yh 生成 platform/console.env，不读这个文件
# 只放「启动前就得有」和「安全底线」的配置；登录方式、模型、钉钉等都在控制台里配
# ============================================================
DATABASE_URL=mysql://root:yh_dev_pwd@127.0.0.1:3327/yh_console
PORT=3105
NODE_ENV=development
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars
# 模型 API Key、设置里密码项的加密密钥(不填则由 JWT_SECRET 派生)
SECRET_KEY=
# 平台接口令牌(yh 用)，至少 24 位；本地开发不需要可留空
PLATFORM_TOKEN=
# 首次启动建初始管理员 admin 的密码
BOOTSTRAP_ADMIN_PASSWORD=admin12345
# 开发登录(选人即登录)。出于安全只能在这里开，生产必须关闭
DEV_LOGIN=true
PUBLIC_URL=http://localhost:5185
